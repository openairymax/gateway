      "caps": [
        {
          "name": "pending",
          "kind": "tool_approve"
        },
        {
          "name": "approve",
          "kind": "tool_approve"
        },
        {
          "name": "register"
        },
        {
          "name": "list_tools"
        },
        {
          "name": "get_tool"
        },
        {
          "name": "execute_tool"
        },
        {
          "name": "execute"
        },
        {
          "name": "list"
        },
        {
          "name": "health_check"
        },
        {
          "name": "get_stats"
        }
