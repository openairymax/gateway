{
  "manifest_version": 1,
  "module": "gateway",
  "generator": "tools/codegen/gateway_gen.py",
  "facades": [
    "ingress",
    "execute",
    "state",
    "governance"
  ],
  "slots": [
    "route",
    "authz",
    "stream",
    "validate",
    "dispatch"
  ],
  "defaults": {
    "timeout_ms": 90000,
    "version": 1
  },
  "sock_bindings": [
    "llm",
    "tool",
    "agent",
    "mem",
    "sched",
    "think",
    "a2a",
    "notify",
    "market",
    "hook",
    "monit",
    "channel",
    "cupolas",
    "maths"
  ],
  "l2_methods": [
    "shutdown",
    "get_stats",
    "health_check"
  ],
  "namespaces": [
    {
      "ns": "agent",
      "owner": "agent",
      "route": true,
      "daemon": "agent_d",
      "sock": "agent",
      "caps": [
        {
          "name": "run",
          "kind": "agent_run",
          "perm": "cap:agent.run"
        },
        {
          "name": "cancel",
          "kind": "agent_run",
          "perm": "cap:agent.control"
        },
        {
          "name": "spawn",
          "perm": "cap:agent.control"
        },
        {
          "name": "terminate",
          "perm": "cap:agent.control"
        },
        {
          "name": "invoke",
          "perm": "cap:agent.control"
        },
        {
          "name": "list"
        },
        {
          "name": "count"
        },
        {
          "name": "health_check"
        },
        {
          "name": "get_stats"
        }
      ]
    },
    {
      "ns": "llm",
      "owner": "llm",
      "route": true,
      "daemon": "llm_d",
      "sock": "llm",
      "caps": [
        {
          "name": "complete"
        },
        {
          "name": "list_models",
          "kind": "llm_list"
        },
        {
          "name": "count_tokens"
        },
        {
          "name": "health_check"
        },
        {
          "name": "get_stats"
        }
      ]
    },
    {
      "ns": "tool",
      "owner": "tool",
      "route": true,
